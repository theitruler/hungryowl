# Copy to .env.local. Never commit real credentials.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
UPLOAD_DIR=./data/uploads
# Optional isolated local preview. Disabled when credentials are configured by default.
# Set true only for a sample preview; never for the live service.
DEMO_MODE=false
